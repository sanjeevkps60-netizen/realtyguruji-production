# ============================================================
# Realty Guruji — Environment Variables
# Copy to .env.local for local dev, and add the same keys in
# Vercel → Project → Settings → Environment Variables.
# The site runs WITHOUT these (curated seed data + guided chat);
# adding them turns on the live database, admin and AI features.
# ============================================================

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Public site URL (used for SEO/canonical/sitemap)
NEXT_PUBLIC_SITE_URL=https://realtyguruji.com

# OpenAI (optional — enables the real AI chatbot/search)
OPENAI_API_KEY=sk-...
